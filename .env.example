# ─── Aplicação ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Autenticação ─────────────────────────────────────────────────────────────
# Segredo HMAC para assinatura de JWT. Em produção, usar valor longo e aleatório.
# Gere com: openssl rand -base64 48
JWT_SECRET=change-me-in-production-use-openssl-rand
JWT_EXPIRATION_HOURS=12

# ─── Banco de dados ───────────────────────────────────────────────────────────
# Contrato do .env de ENTREGA: scripts/build.sh lê estes valores (não o
# manifesto — manifesto não tem segredo) e o docker-compose por cliente os
# interpola. O cliente pode mudar livremente; no CD o secrets.ENV do GitHub
# Environment sobrescreve este arquivo inteiro (nada de segredo no git/var).
DATABASE_NAME=lpsoft
DATABASE_USER=lpsoft
DATABASE_PASSWORD=lpsoft
# @internal — backend LOCAL (mvnw spring-boot:run) lê DATABASE_URL direto via
# Spring (não DATABASE_NAME). Use conforme onde o Postgres está:
#   DATABASE_URL=jdbc:postgresql://localhost:5482/lpsoft   # via host (db-dev)
#   DATABASE_URL=jdbc:postgresql://db:5432/lpsoft          # dentro da rede do compose
# No pacote por cliente o compose monta DATABASE_URL a partir de DATABASE_NAME.
# @end

# ─── Features opcionais ───────────────────────────────────────────────────────
# As variáveis abaixo são lidas APENAS quando a feature correspondente está
# presente no build. Em builds onde a feature não foi incluída, são ignoradas.

# @feature lembretes
# Antecedência (em horas) com que lembretes são disparados antes do início do evento
LEMBRETE_ANTECEDENCIA_HORAS=24
# Endpoint SMTP para envio (formato: smtp://user:pass@host:port)
SMTP_URL=
# @end

# @feature analytics
# Habilita coleta agressiva de métricas (mais carga em troca de granularidade)
ANALYTICS_GRANULAR=false
# @end

# @feature push-notif
# Chave VAPID para envio de Web Push (gerar com web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@example.com
# @end
